{
  "sections": [
    {
      "number": 1,
      "title": "协议与模块资源",
      "rules": [
        "DEST-PORT,123,DIRECT",
        "PROTOCOL,MTProto,Singapore",
        "DOMAIN,github.com,\"Hong Kong\",extended-matching",
        "DOMAIN-SUFFIX,githubusercontent.com,\"Hong Kong\",extended-matching"
      ]
    },
    {
      "number": 2,
      "title": "固定地区与高风控业务",
      "rules": [
        "DOMAIN-SET,https://raw.githubusercontent.com/MaroonYS/surge-rules/main/supercell-direct.conf,DIRECT,extended-matching",
        "DOMAIN,nano.cr18.eu.org,Singapore,extended-matching",
        "DOMAIN-SET,https://raw.githubusercontent.com/MaroonYS/surge-rules/main/direct-cn.conf,DIRECT,extended-matching",
        "DOMAIN-SET,https://raw.githubusercontent.com/MaroonYS/surge-rules/main/hk-finance.conf,\"Hong Kong\",extended-matching,update-interval=3600",
        "DOMAIN-SET,https://raw.githubusercontent.com/MaroonYS/surge-rules/main/sg-finance.conf,Singapore,extended-matching",
        "DOMAIN-SET,https://raw.githubusercontent.com/MaroonYS/surge-rules/main/jp-finance.conf,Japan,extended-matching",
        "DOMAIN-SET,https://raw.githubusercontent.com/MaroonYS/surge-rules/main/kr-finance.conf,Korea,extended-matching",
        "DOMAIN-SET,https://raw.githubusercontent.com/MaroonYS/surge-rules/main/uk-finance.conf,\"United Kingdom\",extended-matching",
        "DOMAIN-SET,https://raw.githubusercontent.com/MaroonYS/surge-rules/main/us-residential.conf,Res-Frontier,extended-matching",
        "DOMAIN-SET,https://raw.githubusercontent.com/MaroonYS/surge-rules/main/finance-context.conf,Res-Frontier,extended-matching",
        "DOMAIN-SET,https://raw.githubusercontent.com/MaroonYS/surge-rules/main/identity-context.conf,Res-Frontier,extended-matching",
        "DOMAIN-SET,https://raw.githubusercontent.com/MaroonYS/surge-rules/main/risk-context.conf,Res-Frontier,extended-matching",
        "DOMAIN-SET,https://raw.githubusercontent.com/MaroonYS/surge-rules/main/crypto.conf,Crypto,extended-matching",
        "DOMAIN-SET,https://raw.githubusercontent.com/MaroonYS/surge-rules/main/web3.conf,Web3,extended-matching"
      ]
    },
    {
      "number": 3,
      "title": "Sukka DOMAIN-SET 阶段（必须完整位于 non_ip / ip 之前）",
      "rules": [
        "DOMAIN-SET,https://ruleset.skk.moe/List/domainset/reject.conf,REJECT,extended-matching",
        "DOMAIN-SET,https://ruleset.skk.moe/List/domainset/reject_extra.conf,REJECT",
        "DOMAIN-SET,https://ruleset.skk.moe/List/domainset/reject_phishing.conf,REJECT",
        "DOMAIN-SET,https://ruleset.skk.moe/List/domainset/speedtest.conf,PROXY,extended-matching",
        "DOMAIN-SET,https://ruleset.skk.moe/List/domainset/cdn.conf,PROXY",
        "DOMAIN-SET,https://ruleset.skk.moe/List/domainset/apple_cdn.conf,DIRECT",
        "DOMAIN-SET,https://raw.githubusercontent.com/MaroonYS/surge-rules/main/microsoft-cdn-download-overlap.conf,DIRECT,extended-matching",
        "DOMAIN-SET,https://ruleset.skk.moe/List/domainset/download.conf,\"Hong Kong\""
      ]
    },
    {
      "number": 4,
      "title": "Sukka non_ip 阶段（窄规则优先于宽规则）",
      "rules": [
        "RULE-SET,https://ruleset.skk.moe/List/non_ip/reject-drop.conf,REJECT-DROP,pre-matching",
        "RULE-SET,https://ruleset.skk.moe/List/non_ip/reject.conf,REJECT,extended-matching",
        "RULE-SET,https://ruleset.skk.moe/List/non_ip/reject-no-drop.conf,REJECT-NO-DROP,extended-matching",
        "RULE-SET,https://ruleset.skk.moe/List/non_ip/cdn.conf,PROXY",
        "RULE-SET,https://ruleset.skk.moe/List/non_ip/stream.conf,\"United States\"",
        "RULE-SET,https://ruleset.skk.moe/List/non_ip/ai.conf,\"United States\"",
        "RULE-SET,https://ruleset.skk.moe/List/non_ip/apple_intelligence.conf,\"United States\",extended-matching",
        "RULE-SET,https://ruleset.skk.moe/List/non_ip/telegram.conf,Singapore",
        "RULE-SET,https://ruleset.skk.moe/List/non_ip/apple_cn.conf,DIRECT",
        "RULE-SET,https://ruleset.skk.moe/List/non_ip/apple_services.conf,\"United States\"",
        "RULE-SET,https://ruleset.skk.moe/List/non_ip/microsoft_cdn.conf,DIRECT",
        "RULE-SET,https://ruleset.skk.moe/List/non_ip/microsoft.conf,\"United States\"",
        "RULE-SET,https://ruleset.skk.moe/List/non_ip/download.conf,\"Hong Kong\"",
        "RULE-SET,https://ruleset.skk.moe/List/non_ip/lan.conf,DIRECT",
        "RULE-SET,https://ruleset.skk.moe/List/non_ip/domestic.conf,DIRECT",
        "RULE-SET,https://ruleset.skk.moe/List/non_ip/direct.conf,DIRECT",
        "RULE-SET,https://ruleset.skk.moe/List/non_ip/global.conf,PROXY"
      ]
    },
    {
      "number": 5,
      "title": "Sukka IP 阶段与最终策略（此处起不得新增自定义域名资源）",
      "rules": [
        "RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/Supercell/Supercell.list,DIRECT,no-resolve",
        "RULE-SET,https://ruleset.skk.moe/List/ip/reject.conf,REJECT-DROP",
        "RULE-SET,https://ruleset.skk.moe/List/ip/stream.conf,\"United States\"",
        "RULE-SET,https://ruleset.skk.moe/List/ip/ai.conf,\"United States\"",
        "RULE-SET,https://ruleset.skk.moe/List/ip/telegram.conf,Singapore",
        "RULE-SET,https://ruleset.skk.moe/List/ip/lan.conf,DIRECT",
        "RULE-SET,https://ruleset.skk.moe/List/ip/domestic.conf,DIRECT",
        "RULE-SET,https://ruleset.skk.moe/List/ip/china_ip.conf,DIRECT",
        "FINAL,PROXY,dns-failed"
      ]
    }
  ]
}
